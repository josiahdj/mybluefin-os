module howdy_gdm 1.1;

# Fedora runs every display manager (GDM, SDDM, LightDM) as xdm_t; there are
# no gdm_t/sddm_t/lightdm_t types, and requiring them makes `semodule -i` fail
# with "Failed to resolve typeattributeset". The base policy already allows
# xdm_t to open/read/ioctl video devices; only `map` is denied, which blocks
# Howdy's camera capture at the login and lock screens.
require {
    type xdm_t, v4l_device_t;
    class chr_file { open read ioctl getattr map };
}

allow xdm_t v4l_device_t:chr_file { open read ioctl getattr map };
